# Salin ke .env dan ganti placeholder. Jangan commit .env.
# Nilai konfigurasi v5.5 lain tetap menggunakan konfigurasi Anda yang ada.
MANUAL_TRACKING_ENABLED=true
TELEGRAM_BOT_TOKEN='123456:REPLACE_WITH_YOUR_BOT_TOKEN'
TELEGRAM_CHAT_ID='123456789'
MANUAL_TELEGRAM_USER_IDS='123456789'
MANUAL_TELEGRAM_CHAT_IDS='123456789'
MANUAL_DASHBOARD_TOKEN='REPLACE_WITH_A_PRIVATE_RANDOM_KEY_AT_LEAST_16_CHARACTERS'

# Semua proses wajib menunjuk file SQLite yang SAMA.
SECRETAGENT_DB_FILE="${PWD}/trading_v5.db"
MANUAL_DB_FILE="${SECRETAGENT_DB_FILE}"

# Konfigurasi Manual Tracker & Trailing Stop
MANUAL_POLL_SECONDS=5
MANUAL_STALE_SECONDS=20
MANUAL_SIGNAL_TTL_SECONDS=86400
MANUAL_SESSION_TTL_SECONDS=900
MANUAL_ACTIVATION_R=1
MANUAL_ATR_PERIOD=14
MANUAL_ATR_MULTIPLIER=2
MANUAL_ATR_INTERVAL=1m
MANUAL_MIN_IMPROVEMENT_TICKS=2
MANUAL_MIN_IMPROVEMENT_R=0.05
MANUAL_COST_BUFFER_BPS=5
MANUAL_REQUESTS_PER_MINUTE=120

# =====================================================================
# PHASE 1-6: AUTONOMOUS TRADING & DYNAMIC RISK CONFIGURATION
# Real-money trading MUST remain disabled by default.
# =====================================================================
EXECUTION_MODE=PAPER
LIVE_TRADING_ENABLED=false
AUTONOMOUS_TRADING_ENABLED=false
DEFAULT_INSTRUMENT=LINEAR
DEFAULT_LEVERAGE=3
DEFAULT_MARGIN_MODE=ISOLATED

# Smart Trailing Stop Mode: ADVISORY (default) | AUTOMATIC
TRAILING_MODE=ADVISORY
AUTO_TRAILING_ENABLED=false

# Emergency & Kill-Switch Policies
EMERGENCY_UNPROTECTED_POLICY=ALERT_AND_HOLD
KILL_SWITCH_PENDING_POLICY=CANCEL_PENDING_ENTRIES

# Deterministic Risk Parameters
RISK_PCT_PER_TRADE=0.005
MAX_DAILY_LOSS_PCT=0.02
MAX_DAILY_LOSS_USDT=500
MAX_AGGREGATE_OPEN_RISK_PCT=0.015
MAX_CONCURRENT_POSITIONS=3
MAX_EXPOSURE_PER_ASSET_PCT=0.20
MAX_PORTFOLIO_EXPOSURE_PCT=0.60
MAX_PERMITTED_LEVERAGE=5
MIN_ACCEPTABLE_RR=1.5
MAX_POSITION_NOTIONAL_USDT=25000
MAX_CONSECUTIVE_LOSSES=3
MAX_EXECUTION_FAILURES=3
MAX_FEE_SHARE_OF_RISK=0.40

# Data Freshness & Latency Limits
MAX_MARKET_DATA_AGE_SECONDS=20
MAX_ACCOUNT_DATA_AGE_SECONDS=30
MAX_SIGNAL_AGE_SECONDS=120
RECONCILE_INTERVAL_SECONDS=30
ABNORMAL_LATENCY_MS=5000

# Paper & Cost Assumptions
PAPER_INITIAL_EQUITY=10000
DEFAULT_MAKER_FEE=0.0002
DEFAULT_TAKER_FEE=0.0004
DEFAULT_SLIPPAGE_BPS=5
DEFAULT_SPREAD_BPS=2
DEFAULT_FUNDING_BPS=1
REQUIRE_AI_APPROVAL=true

# Exchange API Credentials (NEVER commit real keys; disable withdrawal permissions!)
BINANCE_TESTNET_API_KEY=''
BINANCE_TESTNET_API_SECRET=''
BINANCE_API_KEY=''
BINANCE_API_SECRET=''
